NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cloudflare R2 (CDN de imagens) - ex: pub-xxxxx.r2.dev
NEXT_PUBLIC_R2_HOSTNAME=

# Feature flags (ver src/lib/featureFlags.ts). Vazio/ausente = desligada.
# Equipe (Configuracoes > Equipe): tela ainda 100% mock, sem backend de
# convites/papeis. Manter desligada ate o backend existir.
NEXT_PUBLIC_FEATURE_EQUIPE=false

# Sentry (error tracking). Vazio/ausente = SDK fica em modo no-op (nao inicializa,
# nao quebra build nem dev local). Pegar o DSN em Settings > Projects > <projeto> > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Sentry (upload de sourcemaps no build). Opcional - so necessario em CI/deploy para
# stack traces legiveis no Sentry. Sem essas 3 variaveis o build local funciona normal,
# so nao faz upload de sourcemap. Gerar o token em Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=